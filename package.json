{
  "name": "gcse-maths-player",
  "private": true,
  "version": "1.0.0",
  "description": "Offline GCSE Maths practice player (AQA 8300 Higher) + pack tooling",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs app 8080",
    "test": "node tests/run-all.mjs",
    "test:library": "node tests/run-all.mjs --library",
    "vendor": "node tools/vendor.mjs",
    "library": "bash tools/rebuild_library.sh",
    "samples": "python3 tools/make_samples.py",
    "tutor-docs": "python3 tools/build_tutor_docs.py",
    "lint": "node tools/lint.mjs"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "jszip": "3.10.1",
    "katex": "0.16.22",
    "marked": "15.0.12",
    "playwright": "^1.56.1"
  }
}
